# Silent Ledger Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Default (when not set) allows http://localhost:3000 and http://localhost:3001.
# For production, set this to your actual frontend URL only.
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Replace <db_username> and <db_password> with your Atlas credentials.
# Leave unset to run in in-memory fallback mode (data lost on restart).
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@silentledger.gbiwzyu.mongodb.net/silentledger?retryWrites=true&w=majority&appName=silentledger
# DB_USERNAME=your_atlas_username

# ─── Bitcoin (mempool.space) ──────────────────────────────────────────────────
# Defaults to Bitcoin Testnet. Change only if you have a private mempool instance.
# MEMPOOL_API_BASE=https://mempool.space/testnet/api

# ─── Nostr Relays ─────────────────────────────────────────────────────────────
# Comma-separated list of Nostr relay WebSocket URLs.
# Defaults to well-known public relays (see config.js).
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.snort.social

# ─── Nostr Event Kind ─────────────────────────────────────────────────────────
# Kind 30078 is NIP-78 Parameterized Replaceable Application-Specific Data.
# SILENT_LEDGER_NOSTR_KIND=30078

# ─── AI Coach (optional) ──────────────────────────────────────────────────────
# Provide at most one AI key. The backend has a full built-in coaching engine
# that works with zero API keys — these are optional enhancements only.
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
